<?xml version="1.0" encoding="utf-8"?>
<!--
  LexiRead adaptive icon — monochrome layer (Android 13+ themed icons).

  The system discards this layer's colour and tints it from the wallpaper
  palette, so only the alpha channel matters. It is therefore a single ink: the
  slab, with the ribbon punched out via fillType="evenOdd".

  The ribbon sits flush with the slab's top edge, so the cut-out reads as an open
  notch rather than a closed hole — which is what keeps the bookmark legible
  after the gold is taken away.

  Same geometry as ic_launcher_foreground.xml, so the mark does not shift when
  the user turns themed icons on.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#000000"
        android:fillType="evenOdd"
        android:pathData="M39.2 28.8 H68.8 A5.2 5.2 0 0 1 74 34 V74 A5.2 5.2 0 0 1 68.8 79.2 H39.2 A5.2 5.2 0 0 1 34 74 V34 A5.2 5.2 0 0 1 39.2 28.8 Z M60 28.8 H68.8 V55.2 L64.4 47.6 L60 55.2 Z" />
</vector>
