<?xml version="1.0" encoding="utf-8"?>
<!--
  N-6 (audit 2026-09-17): this file is NOT dead code.

  `android:allowBackup="false"` still blocks Auto Backup, but from Android 12 on
  that attribute is deprecated and only covers cloud backups — device-to-device
  transfers are governed by this file instead. Removing it (as the audit
  suggested) would have silently re-enabled transfer of the library, the reading
  progress and the DataStore preferences on modern devices, so the exclusions are
  declared explicitly for both paths.

  Nothing here is backed up: the database holds imported book text, `sharedpref`
  holds the encrypted provider keys and `file` holds downloaded books and the
  settings DataStore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
